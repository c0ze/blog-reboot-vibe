---
/**
 * The rendition switch — the printer's plate selector, set as a corner tag.
 *
 * Four renditions, in menu order: Pulp (native), Pulp HC, Beta (the reversed
 * page), Beta HC. The two HC plates target WCAG AAA. The id list is duplicated
 * in the boot script in BaseLayout.astro; keep them in step.
 */
const renditions = [
  { id: 'pulp', name: 'Pulp', hint: 'light' },
  { id: 'pulp-hc', name: 'Pulp HC', hint: 'high contrast light' },
  { id: 'beta', name: 'Beta', hint: 'dark' },
  { id: 'beta-hc', name: 'Beta HC', hint: 'high contrast dark' },
];
---

<div class="corner" role="group" aria-label="Rendition">
  {renditions.map((r) => (
    <button
      type="button"
      class="corner__btn"
      data-rendition={r.id}
      aria-pressed="false"
      title={`${r.name} — ${r.hint}`}
    >{r.name}</button>
  ))}
</div>

<script is:inline>
(function () {
  var RENDITIONS = ['pulp', 'pulp-hc', 'beta', 'beta-hc'];
  var COLORS = { pulp: '#EDEAE3', 'pulp-hc': '#F1EEE7', beta: '#0B0B0C', 'beta-hc': '#050506' };
  // Returning visitors carry an Ink & Ledger theme id; land them on the
  // nearest plate rather than leaving them themeless.
  var LEGACY = {
    dark: 'beta', light: 'pulp', dracula: 'beta',
    alucard: 'pulp', paper: 'pulp-hc', blade: 'beta', 'dracula-pro': 'beta',
    carbon: 'beta-hc', buffy: 'beta', lincoln: 'beta', morbius: 'beta',
    'van-helsing': 'beta'
  };

  function current() {
    var stored = null;
    try { stored = localStorage.getItem('theme'); } catch (e) {}
    if (stored && LEGACY[stored]) stored = LEGACY[stored];
    if (stored && RENDITIONS.indexOf(stored) !== -1) return stored;
    for (var i = 0; i < RENDITIONS.length; i++) {
      if (document.documentElement.classList.contains(RENDITIONS[i])) return RENDITIONS[i];
    }
    return 'pulp';
  }

  function apply(rendition) {
    RENDITIONS.forEach(function (r) { document.documentElement.classList.remove(r); });
    document.documentElement.classList.add(rendition);
    try { localStorage.setItem('theme', rendition); } catch (e) {}
    var meta = document.querySelector('meta[name="theme-color"]');
    if (meta && COLORS[rendition]) meta.setAttribute('content', COLORS[rendition]);
    sync(rendition);
  }

  function sync(rendition) {
    document.querySelectorAll('[data-rendition]').forEach(function (btn) {
      btn.setAttribute('aria-pressed', String(btn.getAttribute('data-rendition') === rendition));
    });
  }

  function init() {
    sync(current());
    document.querySelectorAll('.corner').forEach(function (group) {
      if (group.hasAttribute('data-init')) return;
      group.setAttribute('data-init', 'true');
      group.querySelectorAll('[data-rendition]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          apply(btn.getAttribute('data-rendition'));
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
