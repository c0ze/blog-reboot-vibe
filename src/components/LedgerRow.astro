---
import { formatDateShort } from '@/lib/display';
import TagChip from '@/components/TagChip.astro';

interface Props {
  slug: string;
  title: string;
  date: Date;
  tags: string[];
  no: string;
  minutes?: number;
  lang?: string;
}

const { slug, title, date, tags, no, minutes, lang } = Astro.props;
---

<div class="ledger__row" data-tags={tags.join(',')}>
  <span class="num meta">{no}</span>
  <time class="num meta" datetime={date.toISOString()}>{formatDateShort(date)}</time>
  <span class="ledger__title" lang={lang && lang !== 'en' ? lang : undefined}>
    <a href={`/blog/${slug}`}>{title}</a>
  </span>
  {minutes !== undefined && <span class="label meta ledger__min">{minutes} min</span>}
  {tags.length > 0 && (
    <span class="tags ledger__tags">
      {tags.slice(0, 5).map((tag) => <TagChip tag={tag} plain />)}
    </span>
  )}
</div>
