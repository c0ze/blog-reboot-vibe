---
import ThemeToggle from './ThemeToggle.astro';
import { getLedger } from '@/lib/ledger';
import { formatDateShort } from '@/lib/display';

const { total, firstYear, latest } = await getLedger();

const pathname = Astro.url.pathname;
const isActive = (path: string) => pathname === path || pathname === path + '/';

const navLinks = [
  { href: '/blog', label: 'Blog' },
  { href: '/archive', label: 'Archive' },
  { href: '/search', label: 'Search' },
];
---

<!-- lang="en" on the chrome: `text-transform: uppercase` follows the element's
     language, and a Turkish post sets <html lang="tr">, which would print
     ARCHİVE and MİN. The chrome is English wherever the post is not. -->
<header class="masthead" lang="en">
  <div>
    <a href="/" aria-label="Coze — home">
      <span class="wordmark">Coze.</span>
    </a>
    <p class="strapline">the ledger of side quests</p>
  </div>

  <div class="masthead__side">
    <nav class="masthead__nav label label--b" aria-label="Primary">
      {navLinks.map((link) => (
        <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>
      ))}
      <a href="/rss.xml">RSS</a>
      <a href="https://arda.tr" rel="noopener noreferrer">arda.tr</a>
    </nav>
    <ThemeToggle />
    <p class="masthead__stat label meta">
      {total} entries · since {firstYear} · latest {formatDateShort(latest)}
    </p>
  </div>
</header>

<!-- The register strip: the four pitches this page is printed in, pulled in
     order. 10 / 30 / 50 / 70, the last one the inverted plate. -->
<svg class="wedge" width="100%" height="14" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="reg10" width="8" height="8" patternUnits="userSpaceOnUse">
      <circle cx="4" cy="4" r="1.01" style="fill:currentColor" /><circle cx="0" cy="0" r="1.01" style="fill:currentColor" /><circle cx="8" cy="0" r="1.01" style="fill:currentColor" /><circle cx="0" cy="8" r="1.01" style="fill:currentColor" /><circle cx="8" cy="8" r="1.01" style="fill:currentColor" />
    </pattern>
    <pattern id="reg30" width="8" height="8" patternUnits="userSpaceOnUse">
      <circle cx="4" cy="4" r="1.75" style="fill:currentColor" /><circle cx="0" cy="0" r="1.75" style="fill:currentColor" /><circle cx="8" cy="0" r="1.75" style="fill:currentColor" /><circle cx="0" cy="8" r="1.75" style="fill:currentColor" /><circle cx="8" cy="8" r="1.75" style="fill:currentColor" />
    </pattern>
    <pattern id="reg50" width="8" height="8" patternUnits="userSpaceOnUse">
      <circle cx="4" cy="4" r="2.26" style="fill:currentColor" /><circle cx="0" cy="0" r="2.26" style="fill:currentColor" /><circle cx="8" cy="0" r="2.26" style="fill:currentColor" /><circle cx="0" cy="8" r="2.26" style="fill:currentColor" /><circle cx="8" cy="8" r="2.26" style="fill:currentColor" />
    </pattern>
    <pattern id="reg70" width="8" height="8" patternUnits="userSpaceOnUse">
      <circle cx="4" cy="4" r="1.75" style="fill:var(--pulp)" /><circle cx="0" cy="0" r="1.75" style="fill:var(--pulp)" /><circle cx="8" cy="0" r="1.75" style="fill:var(--pulp)" /><circle cx="0" cy="8" r="1.75" style="fill:var(--pulp)" /><circle cx="8" cy="8" r="1.75" style="fill:var(--pulp)" />
    </pattern>
  </defs>
  <rect x="0" y="0" width="25%" height="14" fill="url(#reg10)" />
  <rect x="25%" y="0" width="25%" height="14" fill="url(#reg30)" />
  <rect x="50%" y="0" width="25%" height="14" fill="url(#reg50)" />
  <rect x="75%" y="0" width="25%" height="14" style="fill:currentColor" />
  <rect x="75%" y="0" width="25%" height="14" fill="url(#reg70)" />
</svg>
