---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Page Not Found - Coze">
  <div class="section-rule">
    <h1 class="label label--b">Missing entry</h1>
    <span class="section-rule__line"></span>
    <span class="label meta">not in the ledger</span>
  </div>

  <!-- The closing panel: this page spends the screen's one solid fill. -->
  <div class="panel panel--solid missing">
    <span class="missing__n">№404</span>
    <p class="t-2">This page isn’t in the ledger.</p>
    <p class="narration">
      Either it never existed, or it was quietly retired during a side quest.
      The run continues either way.
    </p>
    <div class="row mt-half">
      <a class="readmore" href="/">← the front page</a>
      <a class="readmore" href="/archive">the archive</a>
      <a class="readmore" href="/search">search</a>
    </div>
  </div>
</BaseLayout>
