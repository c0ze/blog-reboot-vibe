---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LedgerRow from '@/components/LedgerRow.astro';
import { getLedger, spell } from '@/lib/ledger';
import { tonePlate } from '@/lib/display';

const { entries, total, years, gaps, firstYear, lastYear } = await getLedger();

// Newest year first, with each empty run printed where it actually falls.
const descending = [...years].reverse();
const byYear = new Map<number, typeof entries>();
for (const entry of entries) {
  const year = entry.date.getUTCFullYear();
  const bucket = byYear.get(year);
  if (bucket) bucket.push(entry);
  else byYear.set(year, [entry]);
}

/** Empty-year runs keyed by their newest year, so they print between tiers. */
const gapAt = new Map<number, (typeof gaps)[number]>();
for (const gap of gaps) gapAt.set(gap.to, gap);
const longestGap = gaps[0];

// Elapsed silence, not empty calendar years: the distance between the last
// entry before the run and the first entry after it.
function elapsed(from: number, to: number): number {
  const before = entries.filter((e) => e.date.getUTCFullYear() < from).at(0);
  const after = entries.filter((e) => e.date.getUTCFullYear() > to).at(-1);
  if (!before || !after) return to - from + 1;
  return Math.floor((after.date.getTime() - before.date.getTime()) / (365.25 * 864e5));
}

const maxYear = Math.max(1, ...years.map((y) => y.count));
const spineHeight = (count: number) => (count === 0 ? 3 : Math.max(5, Math.round((count / maxYear) * 92)));
const voidYears = years.filter((y) => y.count === 0).map((y) => y.year);
---

<BaseLayout title="Archive - Coze" description="Every entry in the Coze ledger, bound by year.">
  <div class="section-rule">
    <h1 class="label label--b">Back issues</h1>
    <span class="section-rule__line"></span>
    <span class="label meta">{total} entries · {firstYear} — {lastYear}</span>
  </div>

  <!-- The volume index: tone pitch is volume, gap years left blank. -->
  <div class="tagindex">
    <p class="narration narration--tight">
      Every entry, bound by year. The run is not uniform and does not pretend to be.
    </p>
    <div
      class="spine mt-half"
      role="img"
      aria-label={`Entries per year, ${firstYear} to ${lastYear}. ${voidYears.join(', ')} are empty.`}
    >
      {years.map(({ year, count }) => (
        <span class={`spine__yr${count === 0 ? ' spine__yr--void' : ''}`}>
          <span
            class={count === 0 ? 'spine__bar spine__bar--void' : `spine__bar ${tonePlate(count, maxYear)}`}
            style={`height:${spineHeight(count)}px`}
          ></span>
          <span class="spine__lab">’{String(year).slice(2)}</span>
        </span>
      ))}
    </div>
  </div>

  <div class="tiers">
    {descending.map(({ year, count }, index) => {
      const gap = gapAt.get(year);
      const yearEntries = byYear.get(year) ?? [];
      return (
        <>
          {count > 0 && (
            <section class="tier-row" aria-label={`${year}`}>
              <div class={`tierlab${year === lastYear ? ' tierlab--now' : ''}`}>
                <span class="tierlab__txt">{year}</span>
                <span class="tierlab__n">{count} {count === 1 ? 'entry' : 'entries'}</span>
              </div>
              <div class="ledger">
                {yearEntries.map((entry) => (
                  <LedgerRow
                    slug={entry.slug}
                    title={entry.post.data.title}
                    date={entry.date}
                    tags={entry.post.data.tags}
                    no={entry.no}
                    minutes={entry.minutes}
                    lang={entry.post.data.lang}
                  />
                ))}
              </div>
            </section>
          )}
          {gap && index < descending.length - 1 && (
            <section class="tier-row" aria-label={`${gap.from} to ${gap.to}, no entries`}>
              <div class="tierlab tierlab--void">
                <span class="tierlab__txt">
                  {gap.from === gap.to ? gap.from : `${gap.from} — ${gap.to}`}
                </span>
                <span class="tierlab__n">0</span>
              </div>
              <div class={`silence ${gap === longestGap ? 'tone-30' : 'tone-10'}`}>
                <p class="silence__cap">
                  <span class="label label--b">
                    {spell(elapsed(gap.from, gap.to))} {elapsed(gap.from, gap.to) === 1 ? 'year' : 'years'}
                  </span><br />
                  <span class="label meta">No entries</span>
                </p>
              </div>
            </section>
          )}
        </>
      );
    })}
  </div>
</BaseLayout>
