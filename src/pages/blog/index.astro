---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LedgerRow from '@/components/LedgerRow.astro';
import { getSlug } from '@/lib/posts';
import { getLedger } from '@/lib/ledger';

const { entries, total, tags, firstYear, lastYear } = await getLedger();
const allTags = [...tags].sort((a, b) => a.tag.localeCompare(b.tag));
---

<BaseLayout title="Blog - Coze" description="All blog posts from Coze - Software Development Journey">
  <div class="section-rule">
    <h1 class="label label--b">The full ledger</h1>
    <span class="section-rule__line"></span>
    <span class="label meta">{total} entries · {firstYear} — {lastYear}</span>
  </div>

  <!-- The filter: the tag chips are the control. Deep-linked from anywhere on
       the site as /blog?tag=dev, and the whole thing degrades to a plain list
       with no script at all. -->
  <div class="tagindex">
    <p class="narration narration--tight">
      Every entry, newest first. Filter by tag — {tags.length} of them, and the
      long tail is real: most are used once.
    </p>
    <div class="tags mt-half" id="tag-filters" role="group" aria-label="Filter entries by tag">
      <button type="button" class="tag tag--active" data-tag="all" aria-pressed="true">All · {total}</button>
      {allTags.map(({ tag, count }) => (
        <button type="button" class="tag" data-tag={tag} aria-pressed="false">{tag} · {count}</button>
      ))}
    </div>
  </div>

  <div class="ledger" id="posts-list" style="margin-top:var(--gut)">
    {entries.map((entry) => (
      <LedgerRow
        slug={getSlug(entry.post)}
        title={entry.post.data.title}
        date={entry.date}
        tags={entry.post.data.tags}
        no={entry.no}
        minutes={entry.minutes}
        lang={entry.post.data.lang}
      />
    ))}
  </div>

  <p id="no-results" class="narration" hidden style="margin-top:var(--gut)">
    №000 — no entries match that tag.
  </p>
</BaseLayout>

<script is:inline>
  (function () {
    var buttons = document.querySelectorAll('#tag-filters .tag');
    var list = document.getElementById('posts-list');
    var rows = list ? list.querySelectorAll('.ledger__row') : [];
    var empty = document.getElementById('no-results');
    if (!list) return;

    function applyFilter(tag, updateUrl) {
      buttons.forEach(function (btn) {
        var active = btn.getAttribute('data-tag') === tag;
        btn.classList.toggle('tag--active', active);
        btn.setAttribute('aria-pressed', String(active));
      });

      var visible = 0;
      rows.forEach(function (row) {
        var rowTags = (row.getAttribute('data-tags') || '').split(',');
        var show = tag === 'all' || rowTags.indexOf(tag) !== -1;
        row.hidden = !show;
        row.classList.toggle('is-band', show && visible % 2 === 1);
        if (show) visible++;
      });
      list.classList.toggle('ledger--filtered', tag !== 'all');
      if (empty) empty.hidden = visible > 0;

      if (updateUrl) {
        var url = new URL(window.location.href);
        if (tag === 'all') url.searchParams.delete('tag');
        else url.searchParams.set('tag', tag);
        history.replaceState(null, '', url);
      }
    }

    buttons.forEach(function (button) {
      button.addEventListener('click', function () {
        var tag = button.getAttribute('data-tag');
        if (tag !== null) applyFilter(tag, true);
      });
    });

    // Deep-link support: a tag chip anywhere links to /blog?tag=dev, landing pre-filtered.
    var requested = new URLSearchParams(window.location.search).get('tag');
    if (requested) {
      var known = false;
      buttons.forEach(function (b) { if (b.getAttribute('data-tag') === requested) known = true; });
      if (known) applyFilter(requested, false);
    }
  })();
</script>
