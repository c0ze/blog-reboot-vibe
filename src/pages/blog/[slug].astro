---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { getPublishedPosts, getSlug } from '@/lib/posts';
import { ledgerNo, readingTimeMinutes, formatDateShort } from '@/lib/display';
import TagChip from '@/components/TagChip.astro';
import LedgerRow from '@/components/LedgerRow.astro';

export async function getStaticPaths() {
  const sortedPosts = await getPublishedPosts();

  return sortedPosts.map((post, index) => {
    // Extract the filename without extensions and without the year parent directory for the slug
    const slug = getSlug(post);

    // Up to 3 related posts, scored by shared-tag count with recency as the
    // tie-break (sortedPosts is newest-first, so a lower index is more recent).
    // Drafts are already excluded by getPublishedPosts(). Build-time only.
    const tags = new Set(post.data.tags);
    const related = sortedPosts
      .map((candidate, candidateIndex) => ({
        candidate,
        candidateIndex,
        shared: candidate.data.tags.filter((tag) => tags.has(tag)).length,
      }))
      .filter(({ candidate, shared }) => candidate.id !== post.id && shared > 0)
      .sort((a, b) => b.shared - a.shared || a.candidateIndex - b.candidateIndex)
      .slice(0, 3)
      .map(({ candidate, candidateIndex }) => ({
        post: candidate,
        no: ledgerNo(candidateIndex, sortedPosts.length),
      }));

    return {
      params: { slug },
      props: {
        post,
        no: ledgerNo(index, sortedPosts.length),
        prevPost: sortedPosts[index + 1] || null,
        nextPost: sortedPosts[index - 1] || null,
        related,
      },
    };
  });
}

const { post, no, prevPost, nextPost, related } = Astro.props;
const { Content } = await render(post);

const minutes = readingTimeMinutes(post.body);
// The reading-time gauge: a tone measure, capped so a 13-minute essay reads
// as long rather than as a bar that leaves the panel.
const gaugeWidth = Math.min(120, Math.max(14, minutes * 9));

// Determine OG image - use post image if available, otherwise default
const ogImage = post.data.image || '/images/og-image.png';
const ogImageAbsolute = new URL(ogImage, Astro.site).href;
---

<BaseLayout
  title={`${post.data.title} - Coze`}
  description={post.data.description || post.data.excerpt}
  image={ogImage}
  keywords={post.data.keywords}
  type="article"
  publishedTime={post.data.date.toISOString()}
  lang={post.data.lang}
>
  <!-- data-pagefind-body scopes the Pagefind search index to post content:
       once any page declares it, pages without it (home, listings) are skipped. -->
  <article class="post" data-pagefind-body>
    <div class="readpanel">
      <header class="post__head">
        <a class="label label--b" href="/blog" lang="en">← back to the ledger</a>

        <div class="strip" lang="en">
          <span class="tab">{no}</span>
          <time class="num meta" datetime={post.data.date.toISOString()}>{formatDateShort(post.data.date)}</time>
          <span class="gauge" title={`${minutes} minute read`}>
            <span class="gauge__bar tone-50" style={`width:${gaugeWidth}px`}></span>
            <span class="label meta">{minutes} min</span>
          </span>
          <span class="strip__spacer"></span>
          {post.data.author && <span class="label meta">{post.data.author}</span>}
        </div>

        <h1 class="t-display post__title">{post.data.title}</h1>

        {post.data.tags.length > 0 && (
          <ul class="tags">
            {post.data.tags.map((tag) => <li><TagChip tag={tag} /></li>)}
          </ul>
        )}
      </header>

      <div class="post__bleed tone-70" aria-hidden="true"></div>

      {post.data.excerpt && (
        <p class="narration narration--boxed">{post.data.excerpt}</p>
      )}

      <!-- The reading column: one 68ch measure of mincho. Media, code and
           tables are not prose and take the panel. -->
      <div class="reading prose mt-half">
        <Content />
      </div>
    </div>

    <!-- Related entries: shared-tag neighbours, resolved at build time.
         data-pagefind-ignore keeps their titles out of this page's search record. -->
    {related.length > 0 && (
      <section aria-labelledby="related-heading" data-pagefind-ignore lang="en">
        <div class="section-rule" style="margin-top:var(--gut)">
          <h2 id="related-heading" class="label label--b">Related entries</h2>
          <span class="section-rule__line"></span>
          <span class="label meta">shared tags</span>
        </div>
        <div class="ledger">
          {related.map(({ post: rel, no: relNo }) => (
            <LedgerRow
              slug={getSlug(rel)}
              title={rel.data.title}
              date={rel.data.date}
              tags={rel.data.tags}
              no={relNo}
              minutes={readingTimeMinutes(rel.body)}
              lang={rel.data.lang}
            />
          ))}
        </div>
      </section>
    )}

    <!-- Prev / next: the page turn is the cliffhanger. -->
    <nav class="postnav" aria-label="Adjacent posts" data-pagefind-ignore>
      {prevPost && (
        <a class="postnav__cell" href={`/blog/${getSlug(prevPost)}`}>
          <span class="label meta" lang="en">← previous entry</span>
          <span class="postnav__title" lang={prevPost.data.lang ?? 'en'}>{prevPost.data.title}</span>
        </a>
      )}
      {nextPost && (
        <a class="postnav__cell postnav__cell--next" href={`/blog/${getSlug(nextPost)}`}>
          <span class="label meta" lang="en">next entry →</span>
          <span class="postnav__title" lang={nextPost.data.lang ?? 'en'}>{nextPost.data.title}</span>
        </a>
      )}
    </nav>
  </article>

  <!-- JSON-LD Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.data.title,
    "description": post.data.description || post.data.excerpt,
    "datePublished": post.data.date.toISOString(),
    "dateModified": post.data.date.toISOString(),
    "image": ogImageAbsolute,
    "author": {
      "@type": "Person",
      "name": post.data.author || "Arda Karaduman",
      "url": "https://arda.tr"
    },
    "publisher": {
      "@type": "Person",
      "name": "Coze"
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://blog.arda.tr/blog/${getSlug(post)}`
    },
    "keywords": post.data.keywords
  })} />
</BaseLayout>
