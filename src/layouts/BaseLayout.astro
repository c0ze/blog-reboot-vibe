---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  keywords?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  lang?: string;
}

const { title, description = "Coze - Software Development Journey", image, keywords, type = 'website', publishedTime, lang = 'en' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : new URL('/images/og-image.png', Astro.site).href;
const ogLocale = lang === 'ja' ? 'ja_JP' : lang === 'tr' ? 'tr_TR' : 'en_US';
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#EDEAE3" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Coze Blog" href={new URL("rss.xml", Astro.site)} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="me" href="https://mastodon.world/@arda" />

    <!-- Fonts: gothic for titling and dialogue, mincho for narration — the
         actual manga convention, and full CJK/Latin-ext coverage for the
         Japanese and Turkish posts. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@500;700;900&family=Zen+Old+Mincho:wght@400;700&display=swap" rel="stylesheet" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Arda Karaduman" />
    {keywords && <meta name="keywords" content={keywords} />}

    <!-- Fediverse -->
    <meta name="fediverse:creator" content="@arda@mastodon.world" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Coze — blog.arda.tr" />
    <meta property="og:locale" content={ogLocale} />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ardakaraduman" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Rendition boot: runs before paint to avoid a flash. Migrates the
         Ink & Ledger theme ids a returning visitor may still be carrying,
         otherwise falls back to the visitor's system preference (including
         prefers-contrast → the AAA plates). Keep the id list in step with
         src/components/ThemeToggle.astro. -->
    <script is:inline>
      (function () {
        var RENDITIONS = ['pulp', 'pulp-hc', 'beta', 'beta-hc'];
        var LEGACY = {
          dark: 'beta', light: 'pulp', dracula: 'beta',
          alucard: 'pulp', paper: 'pulp-hc', blade: 'beta', 'dracula-pro': 'beta',
          carbon: 'beta-hc', buffy: 'beta', lincoln: 'beta', morbius: 'beta',
          'van-helsing': 'beta'
        };
        var COLORS = { pulp: '#EDEAE3', 'pulp-hc': '#F1EEE7', beta: '#0B0B0C', 'beta-hc': '#050506' };
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        if (stored && LEGACY[stored]) stored = LEGACY[stored];
        var rendition = stored;
        if (!rendition || RENDITIONS.indexOf(rendition) === -1) {
          var hc = matchMedia('(prefers-contrast: more)').matches;
          var dark = matchMedia('(prefers-color-scheme: dark)').matches;
          rendition = hc ? (dark ? 'beta-hc' : 'pulp-hc') : (dark ? 'beta' : 'pulp');
        }
        document.documentElement.classList.add(rendition);
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta && COLORS[rendition]) meta.setAttribute('content', COLORS[rendition]);
      })();
    </script>
  </head>
  <body>
    <div class="trim">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <!-- Cloudflare Web Analytics (cookieless). is:inline keeps the beacon verbatim
         so Astro doesn't bundle it or drop the data-cf-beacon attribute. -->
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "bd17608cad3d493a941bb5738f6f645f"}'></script>
    <!-- End Cloudflare Web Analytics -->
  </body>
</html>
